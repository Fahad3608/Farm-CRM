# ─── Database ───────────────────────────────────────────────
# Local dev (docker compose up -d) or your own Neon/Supabase/Railway URL
DATABASE_URL="postgresql://farm:farm@localhost:5432/farmcrm?schema=public"

# ─── Auth ───────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# ─── Optional: demo data ────────────────────────────────────
# You do NOT need these to run the app. The first time you open it, a setup
# page creates your farm and owner account. These only apply if you choose to
# run `npm run db:seed` to load a demo farm for looking around.
SEED_OWNER_EMAIL="owner@farm.local"
SEED_OWNER_PASSWORD="ChangeMe123!"
SEED_OWNER_NAME="Farm Owner"
SEED_DEMO_DATA="true"
