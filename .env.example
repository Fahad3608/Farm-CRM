# ─── Database ───────────────────────────────────────────────
# Local dev (docker compose up -d) or your own Neon/Supabase/Railway URL
DATABASE_URL="postgresql://farm:farm@localhost:5432/farmcrm?schema=public"

# ─── Auth ───────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# ─── First-run owner account (used by `npm run db:seed`) ────
SEED_OWNER_EMAIL="owner@farm.local"
SEED_OWNER_PASSWORD="ChangeMe123!"
SEED_OWNER_NAME="Farm Owner"

# Optional: load demo animals/records with the seed
SEED_DEMO_DATA="true"
