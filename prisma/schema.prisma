// Farm CRM — data model
// Provider: PostgreSQL (works with Neon / Supabase / Railway / self-hosted Docker)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users & access control
// ─────────────────────────────────────────────────────────────

enum Role {
  OWNER   // full access: everything incl. finance + user management
  MANAGER // everything except user management
  VET     // health + breeding records only. No finance, no prices.
  WORKER  // daily logs: feed, milk, weight. No finance.
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(WORKER)
  // Vet-specific
  clinic       String?
  licenseNo    String?
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  healthRecords   HealthRecord[]  @relation("HealthAuthor")
  vetVisits       HealthRecord[]  @relation("HealthVet")
  photos          Photo[]
  transactions    Transaction[]
  feedLogs        FeedLog[]
  auditLogs       AuditLog[]
  sales           Sale[]
}

// ─────────────────────────────────────────────────────────────
// Animals
// ─────────────────────────────────────────────────────────────

enum Species {
  COW
  BUFFALO
  CALF    // Bachra (male) / Bachri (female) — tagged manually, not computed from age
  HEIFER
  GOAT
  SHEEP
  HORSE
  POULTRY
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  CULLED
  LOANED_OUT
}

enum AcquisitionType {
  BORN_ON_FARM
  PURCHASED
  GIFTED
  INHERITED
  OTHER
}

enum ReproStatus {
  NOT_APPLICABLE
  OPEN          // not pregnant, cycling
  BRED          // served, awaiting confirmation
  PREGNANT
  LACTATING
  DRY
  CASTRATED
}

model Animal {
  id        String  @id @default(cuid())
  tagId     String  @unique          // ear tag / farm ID, e.g. COW-001
  name      String                    // friendly name, e.g. "Cow One"
  species   Species
  breed     String?
  sex       Sex
  color     String?
  hornStatus String?                 // horned / polled / dehorned

  dateOfBirth      DateTime?
  ageIsEstimated   Boolean  @default(false)
  dateJoined       DateTime            // date it came onto the farm
  acquisition      AcquisitionType @default(BORN_ON_FARM)
  sourceName       String?             // seller / market / previous owner
  purchasePrice    Decimal? @db.Decimal(12, 2)

  status      AnimalStatus @default(ACTIVE)
  exitDate    DateTime?
  exitReason  String?
  salePrice   Decimal? @db.Decimal(12, 2)
  buyerName   String?

  reproStatus       ReproStatus @default(NOT_APPLICABLE)
  expectedDueDate   DateTime?

  penOrLocation String?
  notes         String?

  // Lineage
  motherId String?
  mother   Animal?  @relation("Dam", fields: [motherId], references: [id], onDelete: SetNull)
  damOf    Animal[] @relation("Dam")
  fatherId String?
  father   Animal?  @relation("Sire", fields: [fatherId], references: [id], onDelete: SetNull)
  sireOf   Animal[] @relation("Sire")

  profilePhotoId String? @unique
  profilePhoto   Photo?  @relation("ProfilePhoto", fields: [profilePhotoId], references: [id], onDelete: SetNull)

  purchaseBatchId String?
  purchaseBatch   PurchaseBatch? @relation(fields: [purchaseBatchId], references: [id], onDelete: SetNull)

  photos          Photo[]          @relation("AnimalPhotos")
  healthRecords   HealthRecord[]
  feedLogs        FeedLog[]
  weights         WeightRecord[]
  milkRecords     MilkRecord[]
  breedingAsDam   BreedingRecord[] @relation("BreedingDam")
  breedingAsSire  BreedingRecord[] @relation("BreedingSire")
  transactions    Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([species, status])
  @@index([name])
  @@index([purchaseBatchId])
}

// ─────────────────────────────────────────────────────────────
// Photos (stored in DB so no third-party storage account is needed)
// ─────────────────────────────────────────────────────────────

model Photo {
  id        String  @id @default(cuid())
  animalId  String?
  animal    Animal? @relation("AnimalPhotos", fields: [animalId], references: [id], onDelete: Cascade)

  mimeType  String
  data      Bytes   // full image (resized client-side, max 1600px)
  thumb     Bytes   // 400px thumbnail
  caption   String?
  bytes     Int     @default(0)

  uploadedById String?
  uploadedBy   User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  profileOf Animal? @relation("ProfilePhoto")

  createdAt DateTime @default(now())

  @@index([animalId])
}

// ─────────────────────────────────────────────────────────────
// Health / veterinary
// ─────────────────────────────────────────────────────────────

enum HealthRecordType {
  VACCINATION
  INJECTION
  DEWORMING
  TREATMENT
  CHECKUP
  SURGERY
  LAB_TEST
  HOOF_CARE
  PREGNANCY_CHECK
  DEATH_REPORT
  OTHER
}

model HealthRecord {
  id       String @id @default(cuid())
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  type        HealthRecordType
  date        DateTime
  title       String            // e.g. "FMD Vaccine — 2nd dose"
  medicine    String?           // medicine / vaccine name
  brand       String?
  batchNo     String?
  dosage      String?           // "5 ml"
  route       String?           // IM / SC / IV / Oral / Topical
  diagnosis   String?
  treatment   String?
  symptoms    String?
  temperatureC Decimal? @db.Decimal(4, 1)
  weightKg    Decimal? @db.Decimal(7, 2)
  withdrawalUntil DateTime?     // milk/meat withdrawal period end
  nextDueDate DateTime?         // next dose / follow-up
  followUpDone Boolean @default(false)

  // Costs — visible to owner/manager only
  medicineCost Decimal? @db.Decimal(12, 2)
  vetFee       Decimal? @db.Decimal(12, 2)

  vetId     String?
  vet       User?   @relation("HealthVet", fields: [vetId], references: [id], onDelete: SetNull)
  vetName   String?  // for external vets without a login

  notes     String?

  createdById String?
  createdBy   User?   @relation("HealthAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId, date])
  @@index([type])
  @@index([nextDueDate])
}

// ─────────────────────────────────────────────────────────────
// Feed
// ─────────────────────────────────────────────────────────────

model FeedType {
  id          String  @id @default(cuid())
  name        String  @unique      // Wheat Straw, Silage, Concentrate, Green Fodder...
  category    String?              // Roughage / Concentrate / Supplement / Mineral
  unit        String  @default("kg")
  costPerUnit Decimal @default(0) @db.Decimal(12, 2)
  supplier    String?
  notes       String?
  active      Boolean @default(true)

  logs      FeedLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeedLog {
  id       String @id @default(cuid())
  date     DateTime

  feedTypeId String
  feedType   FeedType @relation(fields: [feedTypeId], references: [id], onDelete: Restrict)

  // Either one animal, or a group (animalId null + groupLabel set, cost split evenly)
  animalId   String?
  animal     Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)
  groupLabel String?          // e.g. "All cows", "Goat pen B"
  headCount  Int     @default(1)

  quantity  Decimal @db.Decimal(12, 3)
  unitCost  Decimal @db.Decimal(12, 2)
  totalCost Decimal @db.Decimal(12, 2)
  notes     String?

  recordedById String?
  recordedBy   User?  @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  transaction Transaction?

  createdAt DateTime @default(now())

  @@index([date])
  @@index([animalId, date])
}

// ─────────────────────────────────────────────────────────────
// Production & growth
// ─────────────────────────────────────────────────────────────

model WeightRecord {
  id       String   @id @default(cuid())
  animalId String
  animal   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date     DateTime
  weightKg Decimal  @db.Decimal(7, 2)
  notes    String?
  createdAt DateTime @default(now())

  @@index([animalId, date])
}

model MilkRecord {
  id       String   @id @default(cuid())
  animalId String
  animal   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date     DateTime
  session  String   @default("AM") // AM / PM
  litres   Decimal  @db.Decimal(7, 2)
  notes    String?
  createdAt DateTime @default(now())

  @@index([animalId, date])
}

// ─────────────────────────────────────────────────────────────
// Breeding
// ─────────────────────────────────────────────────────────────

enum BreedingMethod {
  NATURAL
  ARTIFICIAL_INSEMINATION
  EMBRYO_TRANSFER
}

enum BreedingStatus {
  BRED
  CONFIRMED_PREGNANT
  NOT_PREGNANT
  ABORTED
  DELIVERED
}

model BreedingRecord {
  id     String @id @default(cuid())
  damId  String
  dam    Animal @relation("BreedingDam", fields: [damId], references: [id], onDelete: Cascade)
  sireId String?
  sire   Animal? @relation("BreedingSire", fields: [sireId], references: [id], onDelete: SetNull)
  sireName String?  // external sire / semen bull name

  method          BreedingMethod @default(NATURAL)
  breedingDate    DateTime
  expectedDueDate DateTime?
  confirmedAt     DateTime?
  actualBirthDate DateTime?
  offspringCount  Int?
  offspringNotes  String?
  status          BreedingStatus @default(BRED)
  cost            Decimal? @db.Decimal(12, 2)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([damId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Finance — single ledger
// ─────────────────────────────────────────────────────────────

enum TxnType {
  INCOME
  EXPENSE
}

model Transaction {
  id     String   @id @default(cuid())
  date   DateTime
  type   TxnType
  category String            // Feed, Veterinary, Medicine, Labour, Equipment, Milk Sales, Animal Sale...
  amount Decimal  @db.Decimal(12, 2)
  description String?
  vendor      String?
  paymentMethod String?      // Cash / Bank / Mobile
  reference     String?

  animalId String?
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)
  // Kept when an animal is deleted, so money already spent can still be
  // attributed to it in the ledger. e.g. "Gauri (COW-001)".
  animalLabel String?
  equipmentId String?
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  // Whose pocket the money came from — a partner, an investor, or whoever
  // fronted the cash. Free text so an old entry keeps its label even if that
  // payer is later removed from the suggestion list; see the Payer model.
  paidBy String?
  // An expense with no animalId is either unlinked by oversight, or genuinely
  // farm-wide (electricity, general labour...). This distinguishes the two so
  // the Finance page can flag the former without nagging about the latter.
  notAnimalSpecific Boolean @default(false)

  // Auto-linked source rows (so costs are never double-counted)
  healthRecordId String? @unique
  healthRecord   HealthRecord? @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
  feedLogId      String? @unique
  feedLog        FeedLog? @relation(fields: [feedLogId], references: [id], onDelete: Cascade)
  batchCostId    String? @unique
  batchCost      BatchCost? @relation(fields: [batchCostId], references: [id], onDelete: Cascade)
  saleId         String? @unique
  sale           Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type, category])
  @@index([animalId])
  @@index([paidBy])
  @@index([equipmentId])
}

// A category someone has deliberately set up, so it always offers itself as
// a suggestion even before it's ever been used on a transaction. Deleting one
// only removes it from the suggestion list — it never touches transactions
// already saved under that name, since category is just a label there.
model Category {
  id        String   @id @default(cuid())
  name      String
  type      TxnType
  // Which higher-level bucket this expense category rolls up into (e.g.
  // "Operational", "Capital & Construction") — set from Settings, so the
  // Finance page can total and drill into related categories together.
  // Null falls back to a built-in default, then "Other".
  group     String?
  createdAt DateTime @default(now())

  @@unique([name, type])
}

// Someone who puts money into the farm — a partner, a family member, an
// investor. Named here so every payer is offered as a suggestion and so
// Finance can total what each one has funded. Removing a payer only drops
// the suggestion; transactions keep the name they were saved with.
model Payer {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Settings & audit
// ─────────────────────────────────────────────────────────────

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Purchase batches — grouping animals bought on the same trip
// with shared costs (transport, market fees, helpers) that are
// divided equally among the animals in the batch.
// ─────────────────────────────────────────────────────────────

model PurchaseBatch {
  id    String   @id @default(cuid())
  name  String
  date  DateTime
  notes String?

  animals Animal[]
  costs   BatchCost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BatchCost {
  id          String   @id @default(cuid())
  batchId     String
  batch       PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(12, 2)

  transaction Transaction?

  createdAt DateTime @default(now())

  @@index([batchId])
}

// ─────────────────────────────────────────────────────────────
// Customers / buyers — who buys what, at what rate, and every
// delivery logged against that rate.
// ─────────────────────────────────────────────────────────────

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  address String?
  notes   String?
  active  Boolean @default(true)

  rates CustomerRate[]
  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// A standing arrangement: this buyer takes this product at this price per
// unit. `dailyQty` is what they normally take in a day — it drives the
// per-day / per-month income projection and pre-fills the quantity when a
// delivery is logged.
model CustomerRate {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  product   String                          // Milk, Manure, Ghee...
  unit      String   @default("litre")
  unitPrice Decimal  @db.Decimal(12, 2)
  dailyQty  Decimal? @db.Decimal(12, 3)
  category  String   @default("Milk Sales") // income category used in the ledger
  active    Boolean  @default(true)
  notes     String?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, product])
}

// One delivery to one buyer. Product, unit and price are copied onto the row,
// so changing a rate later never rewrites what was already sold. Each sale
// auto-creates a linked income Transaction, the same way health records,
// feed logs and batch costs do.
model Sale {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rateId     String?
  rate       CustomerRate? @relation(fields: [rateId], references: [id], onDelete: SetNull)

  date      DateTime
  product   String
  unit      String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(12, 2)
  category  String
  notes     String?

  transaction Transaction?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId, date])
  @@index([date])
}


// Items being built for the farm; expenses remain in the single finance ledger.
enum EquipmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum EquipmentKind {
  EQUIPMENT
  CONSTRUCTION
}

model Equipment {
  id String @id @default(cuid())
  name String
  kind EquipmentKind @default(EQUIPMENT)
  status EquipmentStatus @default(PLANNED)
  location String?
  notes String?
  transactions Transaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
